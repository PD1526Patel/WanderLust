<% layout("/layouts/boilerplate") %>

    <style>
        #filters {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 1.25rem;
            padding-top: 0.5rem;
            align-items: center;
        }

        .filter {
            text-align: center;
            margin-right: 1rem;
            margin-top: 2rem;
            opacity: 0.7;
            transition: opacity 0.2s ease, transform 0.2s ease;
            flex: 0 0 auto;
        }

        .filter:hover {
            opacity: 1;
            cursor: pointer;
            transform: translateY(-1px);
        }

        .filter i {
            font-size: 1rem;
        }

        .filter p {
            font-size: 0.7rem;
            margin-top: 0.15rem;
            margin-bottom: 0;
            white-space: nowrap;
        }

        .tax-toggle {
            border: 1px solid #d1d1d1;
            border-radius: 0.8rem;
            height: 3.25rem;
            padding: 0.4rem 0.8rem;
            margin-left: 2rem;
            display: flex;
            align-items: center;
            flex-shrink: 0;
        }

        @media (max-width: 768px) {
            .tax-toggle {
                margin-left: 0;
                width: 100%;
                justify-content: center;
                margin-top: 0.5rem;
            }
        }

        .tax-info {
            display: none;
        }

        .tax-toggle {
            border: 1px solid black;
            border-radius: 1rem;
            height: 3.5rem;
            padding: 1rem;
        }
    </style>

    <div class="d-flex justify-content-end mt-2">
        <button class="btn btn-outline-secondary btn-sm" type="button" data-bs-toggle="collapse"
            data-bs-target="#filterCollapse" aria-expanded="true" aria-controls="filterCollapse">
            <i class="fa-solid fa-sliders me-1"></i> Filters
        </button>
    </div>

    <div class="collapse show" id="filters">
        <% categories.forEach(cat=> { %>
            <div class="filter <%= activeCategory === cat.key ? 'active' : '' %>" data-category="<%= cat.key %>">
                <div><i class="<%= cat.icon %>"></i></div>
                <p>
                    <%= cat.label %>
                </p>
            </div>
            <% }); %>
