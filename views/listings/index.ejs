                <div class="tax-toggle">
                    <div class="form-check-reverse form-switch">
                        <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault">
                        <label class="form-check-label" for="switchCheckDefault">Display total after taxes</label>
                    </div>
                </div>
    </div>

    <% if(allListings.length===0) { %>
        <div class="col-6 offset-3 text-center mt-5">
            <h3>No listings found</h3>
            <% if (searchQuery || activeCategory) { %>
                <p class="text-muted">Try resetting your filters or search terms.</p>
                <% } %>
                    <a href="/listings" class="btn btn-dark mt-2">Clear Filters</a>
        </div>
        <% } else { %>
            <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 g-4 mt-3">
                <% for (let listing of allListings) { %>
                    <div class="col">
                        <a href="/listings/<%= listing._id %>" class="listing-link">
                            <div class="card listing-card">
                                <img src="<%= listing.image.url %>" class="card-img-top" alt="listing_image"
                                    style="height: 20rem; object-fit: cover;" />

                                <div class="card-img-overlay">
                                </div>

                                <div class="card-body">
                                    <!-- <h5 class="card-title">Card title</h5> -->
                                    <p class="card-text">
                                        <b>
                                            <%= listing.title %> <br />
                                        </b>
                                        &#8377; <%= listing.price.toLocaleString("en-IN") %> / Night
                                            <i class="tax-info"> &nbsp; &nbsp; +18% GST</i>
                                    </p>
                                    <!-- <a href="#" class="btn btn-primary">Go somewhere</a> -->
                                </div>
                            </div>
                        </a>
                    </div>
                    <% } %>
            </div>
            <% } %>

                <script>
                    let taxSwitch = document.getElementById("switchCheckDefault");
                    taxSwitch.addEventListener("click", () => {
                        let taxInfo = document.getElementsByClassName('tax-info');
                        for (info of taxInfo) {
                            info.style.display = (info.style.display !== 'inline') ? 'inline' : 'none';
                        }
                    })

                    const activeCategory = "<%= activeCategory || '' %>";
                    const searchQuery = "<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>";
                    
                    document.querySelectorAll(".filter").forEach((filterEl) => {
                        filterEl.addEventListener("click", () => {
                            const category = filterEl.dataset.category;
                            const urlParams = new URLSearchParams(window.location.search);

                            // Clicking the already-active filter clears it, otherwise apply it.
                            if (category === activeCategory) {
                                urlParams.delete('category')
                            } else {
                                urlParams.set('category', category)
                            }

                            if (searchQuery) {
                                urlParams.set('q', searchQuery);
                            }
                            const queryString = urlParams.toString();
                            window.location.href = `/listings${queryString ? '?' + queryString : ''}`;
                        });
                    });
                </script>